<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#101827"
        app:title="J.A.R.V.I.S"
        app:titleTextColor="#FFFFFF"/>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM ONLINE"
                android:textColor="#35D6A0"
                android:textSize="13sp"
                android:layout_marginTop="25dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL AI ASSISTANT"
                android:textColor="#7E94B8"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How can I help you today?"
                android:textColor="#DCE6F5"
                android:textSize="19sp"
                android:layout_marginTop="45dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/micButton"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:text="MIC&#10;TAP TO SPEAK"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="35dp"
                app:cornerRadius="100dp"
                app:backgroundTint="#124568"
                app:strokeColor="#35C9E8"
                app:strokeWidth="3dp"/>

            <TextView
                android:id="@+id/responseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JARVIS is waiting for your command."
                android:textColor="#A9BBD2"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="28dp"
                android:padding="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="OPEN CHAT"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1C3048"
                app:cornerRadius="14dp"
                android:layout_marginTop="25dp"/>

            <!-- CHAT PANEL -->

            <LinearLayout
                android:id="@+id/chatPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#111D31"
                android:padding="14dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS CHAT"
                    android:textColor="#35C9E8"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/chatHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="JARVIS: Good day. How may I help you?"
                    android:textColor="#DCE6F5"
                    android:textSize="15sp"
                    android:padding="10dp"
                    android:lineSpacingExtra="5dp"
                    android:textIsSelectable="true"/>

                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ask JARVIS anything..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A9BB5"
                    android:background="#1C3048"
                    android:padding="14dp"
                    android:minHeight="55dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:layout_marginTop="15dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendButton"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="SEND"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp"
                    app:backgroundTint="#087FA5"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="SETTINGS"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1C3048"
                app:cornerRadius="14dp"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fullStorageButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="FULL STORAGE ACCESS: OFF"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6A3D24"
                app:cornerRadius="14dp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS 1.0 • PERSONAL EDITION"
                android:textColor="#526782"
                android:textSize="11sp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
